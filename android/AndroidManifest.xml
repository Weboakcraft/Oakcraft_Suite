<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="in.oakcraft.suite"
    android:versionCode="__VERSION_CODE__"
    android:versionName="__VERSION_NAME__">

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="34" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Installing / updating the OakCraft apps from their GitHub releases (Android asks once: "allow from this source"). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- So the launcher can see whether the OakCraft apps are installed and which version (Android 11+ package visibility).
         QUERY_ALL_PACKAGES keeps this working for apps added to apps.json later, without a new Suite build. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <queries>
        <package android:name="in.oakcraft.crm" />
        <package android:name="in.oakcraft.stock" />
        <package android:name="in.oakcraft.attendance" />
        <intent><action android:name="android.intent.action.MAIN" /></intent>
        <intent><action android:name="android.intent.action.VIEW" /><data android:scheme="https" /></intent>
        <intent><action android:name="android.intent.action.VIEW" /><data android:mimeType="application/vnd.android.package-archive" /></intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/AppTheme"
        android:allowBackup="true"
        android:usesCleartextTraffic="false"
        android:hardwareAccelerated="true"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|uiMode|smallestScreenSize"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Hands downloaded APKs to the system package installer. -->
        <provider
            android:name=".ShareProvider"
            android:authorities="in.oakcraft.suite.files"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
